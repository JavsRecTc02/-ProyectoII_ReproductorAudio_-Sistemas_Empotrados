#include <stdio.h>
#include <stdint.h>
#include <unistd.h>

#include "system.h"
#include "io.h"
#include "audio_nios.h"

/* AUDIO_IF register offsets */
#define AUDIO_DAC_LFIFO_PORT   0
#define AUDIO_DAC_RFIFO_PORT   1
#define AUDIO_ADC_LFIFO_PORT   2
#define AUDIO_ADC_RFIFO_PORT   3
#define AUDIO_CMD_PORT         4
#define AUDIO_STATUS_PORT      5

#define MASK_STATUS_DAC_FULL   0x01

/* OpenCores I2C register offsets */
#define I2C_PRER_LO   0
#define I2C_PRER_HI   1
#define I2C_CTR       2
#define I2C_TXR_RXR   3
#define I2C_CR_SR     4

#define I2C_CTR_EN    0x80

#define I2C_CR_STA_WR 0x90
#define I2C_CR_WR     0x10
#define I2C_CR_STO    0x40

#define I2C_SR_RXACK  0x80
#define I2C_SR_TIP    0x02

/*
 * Volumen de salida del WM8731.
 * 0x79 era aprox 0 dB y podía sonar muy fuerte.
 * Para pruebas limpias empezamos más bajo.
 *
 * Puedes probar luego:
 * 0x50 bajo/moderado
 * 0x58 moderado
 * 0x60 más alto
 * 0x79 0 dB, más fuerte
 */
#define AUDIO_LINEOUT_VOL_SAFE 0x50

static int i2c_wait_tip_clear(void) {
    uint32_t timeout = 1000000;

    while ((IORD(OC_I2C_MASTER_0_BASE, I2C_CR_SR) & I2C_SR_TIP) && timeout--) {
        /* wait */
    }

    return timeout != 0;
}

static int i2c_check_ack(void) {
    uint32_t status = IORD(OC_I2C_MASTER_0_BASE, I2C_CR_SR);
    return ((status & I2C_SR_RXACK) == 0);
}

static int i2c_write_byte(uint8_t data, uint8_t command, int check_ack) {
    IOWR(OC_I2C_MASTER_0_BASE, I2C_TXR_RXR, data);
    IOWR(OC_I2C_MASTER_0_BASE, I2C_CR_SR, command);

    if (!i2c_wait_tip_clear()) {
        return 0;
    }

    if (check_ack && !i2c_check_ack()) {
        return 0;
    }

    return 1;
}

void oc_i2c_audio_init(void) {
    /*
     * I2C 100 kHz:
     * prescale = 50 MHz / (5 * 100 kHz) - 1 = 99 = 0x63
     */

    /*
     * Deshabilitar antes de configurar.
     * Esto ayuda si el core I2C quedó en un estado anterior.
     */
    IOWR(OC_I2C_MASTER_0_BASE, I2C_CTR, 0x00);
    usleep(1000);

    IOWR(OC_I2C_MASTER_0_BASE, I2C_PRER_LO, 0x63);
    IOWR(OC_I2C_MASTER_0_BASE, I2C_PRER_HI, 0x00);

    /* Enable I2C core */
    IOWR(OC_I2C_MASTER_0_BASE, I2C_CTR, I2C_CTR_EN);

    printf("[NIOS] I2C prescaler LO = 0x%02lx\n",
           IORD(OC_I2C_MASTER_0_BASE, I2C_PRER_LO) & 0xFF);

    printf("[NIOS] I2C prescaler HI = 0x%02lx\n",
           IORD(OC_I2C_MASTER_0_BASE, I2C_PRER_HI) & 0xFF);

    printf("[NIOS] I2C control = 0x%02lx\n",
           IORD(OC_I2C_MASTER_0_BASE, I2C_CTR) & 0xFF);
}

static int oc_i2c_audio_wr_reg(uint8_t reg, uint16_t data) {
    uint8_t reg_data;

    /*
     * WM8731:
     * 0x34 = device address + write
     */
    if (!i2c_write_byte(0x34, I2C_CR_STA_WR, 1)) {
        printf("[NIOS][I2C] No ACK on device address, reg=%u\n", reg);
        return 0;
    }

    reg_data = ((reg << 1) & 0xFE) | ((data >> 8) & 0x01);

    if (!i2c_write_byte(reg_data, I2C_CR_WR, 1)) {
        printf("[NIOS][I2C] No ACK on register byte, reg=%u\n", reg);
        return 0;
    }

    if (!i2c_write_byte(data & 0xFF, I2C_CR_WR, 1)) {
        printf("[NIOS][I2C] No ACK on data byte, reg=%u data=0x%04x\n", reg, data);
        return 0;
    }

    IOWR(OC_I2C_MASTER_0_BASE, I2C_CR_SR, I2C_CR_STO);
    usleep(1000);

    return 1;
}

int audio_dac_fifo_not_full(void) {
    uint32_t status = IORD(AUDIO_IF_0_BASE, AUDIO_STATUS_PORT);
    return ((status & MASK_STATUS_DAC_FULL) == 0);
}

void audio_dac_fifo_set_data(int16_t left, int16_t right) {
    IOWR(AUDIO_IF_0_BASE, AUDIO_DAC_LFIFO_PORT, (uint16_t)left);
    IOWR(AUDIO_IF_0_BASE, AUDIO_DAC_RFIFO_PORT, (uint16_t)right);
}

void audio_fifo_clear(void) {
    IOWR(AUDIO_IF_0_BASE, AUDIO_CMD_PORT, 0x01);
}

static int audio_interface_active(int active) {
    return oc_i2c_audio_wr_reg(9, active ? 0x0001 : 0x0000);
}

static int audio_dac_soft_mute(int enable) {
    uint16_t control = 0x0000;

    if (enable) {
        control |= (1 << 3);
    }

    return oc_i2c_audio_wr_reg(5, control);
}

static int audio_line_in_mute(int mute) {
    uint16_t control_l = 0x0017;
    uint16_t control_r = 0x0017;

    if (mute) {
        control_l |= (1 << 7);
        control_r |= (1 << 7);
    }

    if (!oc_i2c_audio_wr_reg(0, control_l)) {
        return 0;
    }

    usleep(10000);

    if (!oc_i2c_audio_wr_reg(1, control_r)) {
        return 0;
    }

    return 1;
}

static int audio_set_line_out_vol(uint8_t l_vol, uint8_t r_vol) {
    uint16_t control;

    /*
     * Headphone out volume registers:
     * reg 2 = left
     * reg 3 = right
     */
    control = 0x005B;
    control &= 0xFF80;
    control += l_vol & 0x7F;

    if (!oc_i2c_audio_wr_reg(2, control)) {
        return 0;
    }

    usleep(10000);

    control = 0x005B;
    control &= 0xFF80;
    control += r_vol & 0x7F;

    if (!oc_i2c_audio_wr_reg(3, control)) {
        return 0;
    }

    return 1;
}

static int audio_set_sample_rate_32k(void) {
    /*
     * RATE_ADC32K_DAC32K:
     * SR = 0x6, BOSR = 1
     */
    uint16_t control = (0x6 << 2) | 0x02;
    return oc_i2c_audio_wr_reg(8, control);
}

int init_audio(void) {
    int ok = 1;

    printf("[NIOS] Initializing audio codec...\n");

    /*
     * Reset codec.
     */
    if (ok) ok = oc_i2c_audio_wr_reg(15, 0x0000);
    usleep(10000);

    /*
     * Desactivar interfaz mientras configuramos.
     */
    if (ok) ok = audio_interface_active(0);
    usleep(10000);

    /*
     * Mutear line-in desde el inicio.
     * Esto reduce ruido analógico de entradas no usadas.
     */
    if (ok) ok = audio_line_in_mute(1);
    usleep(10000);

    /*
     * Volumen de salida inicial moderado.
     */
    if (ok) ok = audio_set_line_out_vol(AUDIO_LINEOUT_VOL_SAFE,
                                        AUDIO_LINEOUT_VOL_SAFE);
    usleep(10000);

    /*
     * Analogue Audio Path Control.
     *
     * 0x0010 = DACSEL = 1.
     *
     * Esto deja seleccionado el DAC para salida analógica y evita:
     * - mic boost
     * - bypass
     * - sidetone
     * - entradas analógicas innecesarias
     *
     * Esta es una de las partes más importantes para reducir ruido.
     */
    if (ok) ok = oc_i2c_audio_wr_reg(4, 0x0010);
    usleep(10000);

    /*
     * Digital Audio Path Control.
     *
     * 0x0000:
     * - soft mute desactivado
     * - de-emphasis desactivado
     * - high pass no importa para DAC playback
     */
    if (ok) ok = oc_i2c_audio_wr_reg(5, 0x0000);
    usleep(10000);

    /*
     * Power Down Control.
     * 0x0000 = todo encendido.
     */
    if (ok) ok = oc_i2c_audio_wr_reg(6, 0x0000);
    usleep(10000);

    /*
     * Digital Audio Interface Format.
     * 0x0042:
     * - I2S
     * - 16 bits
     * - master mode
     *
     * Lo dejamos como lo tenías porque el tono seno funcionaba bien.
     */
    if (ok) ok = oc_i2c_audio_wr_reg(7, 0x0042);
    usleep(10000);

    /*
     * Sample rate 32 kHz para coincidir con ffmpeg -ar 32000.
     */
    if (ok) ok = audio_set_sample_rate_32k();
    usleep(10000);

    /*
     * Limpiar FIFO antes de activar.
     */
    audio_fifo_clear();
    usleep(10000);

    /*
     * Asegurar que no quede soft mute activo.
     */
    if (ok) ok = audio_dac_soft_mute(0);
    usleep(10000);

    /*
     * Activar interfaz al final.
     */
    if (ok) ok = audio_interface_active(1);
    usleep(10000);

    if (!ok) {
        printf("[NIOS] Audio codec init FAILED\n");
        return 0;
    }

    printf("[NIOS] Audio codec init OK\n");
    printf("[NIOS] Line-out volume = 0x%02x\n", AUDIO_LINEOUT_VOL_SAFE);
    printf("[NIOS] Codec path = DAC only, 32 kHz, I2S 16-bit\n");

    return 1;
}
