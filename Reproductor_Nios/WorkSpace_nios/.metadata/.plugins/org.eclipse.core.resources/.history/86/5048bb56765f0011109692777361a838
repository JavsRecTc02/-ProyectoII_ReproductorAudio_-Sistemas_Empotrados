#include <stdio.h>
#include <stdint.h>
#include <unistd.h>

#include "system.h"
#include "io.h"

#include "shared_protocol.h"
#include "audio_nios.h"

#ifndef ERR_BAD_BUFFER_SIZE
#define ERR_BAD_BUFFER_SIZE 100u
#endif

/*
 * Como en tus pruebas el swap de bytes mejoró un poco,
 * lo dejamos activado aquí en Nios.
 *
 * Si luego pruebas y suena peor, cambia a 0.
 */
#define NIOS_SWAP_16BIT_SAMPLE_BYTES 1

static inline void mem_barrier(void) {
    __asm__ volatile ("" ::: "memory");
}

static inline void shm_write(uint32_t offset, uint32_t value) {
    IOWR(SHARED_RAM_BASE, offset, value);
    mem_barrier();
}

static inline uint32_t shm_read(uint32_t offset) {
    mem_barrier();
    return IORD(SHARED_RAM_BASE, offset);
}

static uint16_t swap16_u(uint16_t x) {
    return (uint16_t)((x >> 8) | (x << 8));
}

static int16_t fix_sample_format(uint16_t raw) {
#if NIOS_SWAP_16BIT_SAMPLE_BYTES
    raw = swap16_u(raw);
#endif
    return (int16_t)raw;
}

static void shared_ram_init(void) {
    shm_write(SHM_MAGIC, MAGIC_VALUE);
    shm_write(SHM_VERSION, SHM_VERSION_VALUE);

    shm_write(SHM_COMMAND, CMD_NONE);
    shm_write(SHM_STATUS, STATUS_BOOTING);
    shm_write(SHM_FLAGS, 0);

    shm_write(SHM_SAMPLE_RATE, PCM_SAMPLE_RATE_HZ);
    shm_write(SHM_CHANNELS, PCM_CHANNELS);
    shm_write(SHM_BITS_PER_SAMPLE, PCM_BITS_PER_SAMPLE);

    shm_write(SHM_ACTIVE_BUFFER, 0);

    shm_write(SHM_BUFFER0_READY, 0);
    shm_write(SHM_BUFFER1_READY, 0);
    shm_write(SHM_BUFFER0_SIZE, 0);
    shm_write(SHM_BUFFER1_SIZE, 0);

    shm_write(SHM_COUNTER, 0);
    shm_write(SHM_UNDERRUNS, 0);
    shm_write(SHM_LAST_ERROR, ERR_NONE);
    shm_write(SHM_TOTAL_WORDS_SENT, 0);
    shm_write(SHM_TOTAL_WORDS_PLAYED, 0);
}

static int stop_requested(void) {
    uint32_t cmd = shm_read(SHM_COMMAND);
    uint32_t flags = shm_read(SHM_FLAGS);

    return (cmd == CMD_STOP) || ((flags & FLAG_STOP_REQUEST) != 0);
}

static int validate_buffer_size(uint32_t buffer_id, uint32_t size_words) {
    if (size_words == 0) {
        printf("[NIOS][ERROR] Buffer%lu size is zero\n", buffer_id);
        shm_write(SHM_LAST_ERROR, ERR_BAD_BUFFER_SIZE);
        shm_write(SHM_STATUS, STATUS_ERROR);
        return 0;
    }

    if (size_words > SHM_BUFFER_WORDS) {
        printf("[NIOS][ERROR] Buffer%lu size too large: %lu > %lu\n",
               buffer_id,
               size_words,
               (uint32_t)SHM_BUFFER_WORDS);

        shm_write(SHM_LAST_ERROR, ERR_BAD_BUFFER_SIZE);
        shm_write(SHM_STATUS, STATUS_ERROR);
        return 0;
    }

    return 1;
}

static int play_one_buffer(uint32_t buffer_word_offset, uint32_t size_words) {
    uint32_t i;
    uint32_t local_played = 0;

    for (i = 0; i < size_words; i++) {
        if (stop_requested()) {
            return 0;
        }

        uint32_t pcm_word = shm_read(buffer_word_offset + i);

        /*
         * Formato esperado en Shared_RAM:
         * bits [15:0]  = left raw 16-bit
         * bits [31:16] = right raw 16-bit
         */
        uint16_t raw_left  = (uint16_t)(pcm_word & 0xFFFF);
        uint16_t raw_right = (uint16_t)((pcm_word >> 16) & 0xFFFF);

        int16_t left = fix_sample_format(raw_left);
        int16_t right = fix_sample_format(raw_right);

        while (!audio_dac_fifo_not_full()) {
            if (stop_requested()) {
                return 0;
            }
        }

        audio_dac_fifo_set_data(left, right);
        local_played++;
    }

    shm_write(SHM_TOTAL_WORDS_PLAYED,
              shm_read(SHM_TOTAL_WORDS_PLAYED) + local_played);

    return 1;
}

static void release_buffer0(void) {
    shm_write(SHM_BUFFER0_SIZE, 0);
    mem_barrier();
    shm_write(SHM_BUFFER0_READY, 0);
}

static void release_buffer1(void) {
    shm_write(SHM_BUFFER1_SIZE, 0);
    mem_barrier();
    shm_write(SHM_BUFFER1_READY, 0);
}

static void play_pcm_from_shared_ram(void) {
    uint32_t active = 0;
    int stopped = 0;

    printf("[NIOS] Starting PCM playback from Shared_RAM\n");

    audio_fifo_clear();
    usleep(1000);

    shm_write(SHM_LAST_ERROR, ERR_NONE);
    shm_write(SHM_ACTIVE_BUFFER, active);

    shm_write(SHM_STATUS, STATUS_PLAYING);
    shm_write(SHM_COMMAND, CMD_NONE);

    while (1) {
        uint32_t flags = shm_read(SHM_FLAGS);

        if (stop_requested()) {
            printf("[NIOS] Stop requested\n");
            shm_write(SHM_COMMAND, CMD_NONE);
            stopped = 1;
            break;
        }

        if (active == 0) {
            uint32_t ready = shm_read(SHM_BUFFER0_READY);

            if (ready) {
                uint32_t size_words = shm_read(SHM_BUFFER0_SIZE);

                if (!validate_buffer_size(0, size_words)) {
                    break;
                }

                shm_write(SHM_ACTIVE_BUFFER, 0);

                if (!play_one_buffer(SHM_BUFFER0_WORD, size_words)) {
                    stopped = 1;
                    break;
                }

                release_buffer0();
                active = 1;
            } else {
                if ((flags & FLAG_EOF) && !shm_read(SHM_BUFFER1_READY)) {
                    break;
                }

                shm_write(SHM_STATUS, STATUS_WAITING_DATA);
                shm_write(SHM_UNDERRUNS, shm_read(SHM_UNDERRUNS) + 1);
                usleep(100);
                shm_write(SHM_STATUS, STATUS_PLAYING);
            }
        } else {
            uint32_t ready = shm_read(SHM_BUFFER1_READY);

            if (ready) {
                uint32_t size_words = shm_read(SHM_BUFFER1_SIZE);

                if (!validate_buffer_size(1, size_words)) {
                    break;
                }

                shm_write(SHM_ACTIVE_BUFFER, 1);

                if (!play_one_buffer(SHM_BUFFER1_WORD, size_words)) {
                    stopped = 1;
                    break;
                }

                release_buffer1();
                active = 0;
            } else {
                if ((flags & FLAG_EOF) && !shm_read(SHM_BUFFER0_READY)) {
                    break;
                }

                shm_write(SHM_STATUS, STATUS_WAITING_DATA);
                shm_write(SHM_UNDERRUNS, shm_read(SHM_UNDERRUNS) + 1);
                usleep(100);
                shm_write(SHM_STATUS, STATUS_PLAYING);
            }
        }
    }

    audio_fifo_clear();

    shm_write(SHM_BUFFER0_READY, 0);
    shm_write(SHM_BUFFER1_READY, 0);
    shm_write(SHM_BUFFER0_SIZE, 0);
    shm_write(SHM_BUFFER1_SIZE, 0);
    shm_write(SHM_COMMAND, CMD_NONE);

    if (shm_read(SHM_STATUS) == STATUS_ERROR) {
        printf("[NIOS] PCM playback aborted with STATUS_ERROR\n");
        return;
    }

    if (stopped) {
        shm_write(SHM_STATUS, STATUS_STOPPED);
        printf("[NIOS] PCM playback stopped\n");
    } else {
        shm_write(SHM_STATUS, STATUS_FINISHED);
        printf("[NIOS] PCM playback finished\n");
    }
}

int main(void) {
    printf("[NIOS] Boot\n");

    shared_ram_init();

    oc_i2c_audio_init();

    if (!init_audio()) {
        shm_write(SHM_STATUS, STATUS_ERROR);
        shm_write(SHM_LAST_ERROR, ERR_AUDIO_INIT);

        while (1) {
            IOWR(LED_PIO_BASE, 0, 0x3FF);
            usleep(200000);
            IOWR(LED_PIO_BASE, 0, 0x000);
            usleep(200000);
        }
    }

    /*
     * Tu HPS viejo esperaba 500 ms antes de iniciar reproducción.
     * Dejamos un delay parecido para estabilizar codec/FIFO.
     */
    usleep(500000);

    shm_write(SHM_STATUS, STATUS_READY);

    printf("[NIOS] Ready. Waiting for CMD_PLAY_PCM.\n");
    printf("[NIOS] NIOS_SWAP_16BIT_SAMPLE_BYTES = %d\n", NIOS_SWAP_16BIT_SAMPLE_BYTES);

    uint32_t counter = 0;

    while (1) {
        uint32_t cmd = shm_read(SHM_COMMAND);

        shm_write(SHM_COUNTER, counter++);

        if (cmd == CMD_INIT_AUDIO) {
            printf("[NIOS] Reinitializing audio\n");

            shm_write(SHM_COMMAND, CMD_NONE);
            shm_write(SHM_STATUS, STATUS_BOOTING);

            if (init_audio()) {
                usleep(500000);
                shm_write(SHM_LAST_ERROR, ERR_NONE);
                shm_write(SHM_STATUS, STATUS_READY);
            } else {
                shm_write(SHM_LAST_ERROR, ERR_AUDIO_INIT);
                shm_write(SHM_STATUS, STATUS_ERROR);
            }
        } else if (cmd == CMD_PLAY_PCM) {
            play_pcm_from_shared_ram();
        } else if (cmd == CMD_STOP) {
            printf("[NIOS] Stop command received while idle\n");

            shm_write(SHM_COMMAND, CMD_NONE);
            audio_output_silence(3200);
            usleep(10000);

            audio_fifo_clear();
            usleep(10000);

            audio_output_silence(512);
            usleep(10000);

            shm_write(SHM_BUFFER0_READY, 0);
            shm_write(SHM_BUFFER1_READY, 0);
            shm_write(SHM_BUFFER0_SIZE, 0);
            shm_write(SHM_BUFFER1_SIZE, 0);
            shm_write(SHM_COMMAND, CMD_NONE);
        }

        usleep(1000);
    }

    return 0;
}
